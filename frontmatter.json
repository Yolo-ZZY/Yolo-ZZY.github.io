    },


    {
      "name": "项目部署",
      "description": "用于记录完整项目部署流程",

      "pageBundle": false,
      "fileType": "md",

      "template": "[[workspace]]/.frontmatter/templates/deployment.md",

      "fields": [
        {
          "title": "标题",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "发布日期",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "更新时间",
          "name": "updated",
          "type": "datetime",
          "default": "{{now}}",
          "isModifiedDate": true
        },
        {
          "title": "分类",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "标签",
