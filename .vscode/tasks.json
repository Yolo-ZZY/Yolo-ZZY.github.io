{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "创建文章",
      "type": "shell",
      "command": "npm",
      "args": ["run", "new", "--", "${input:postTitle}"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "本地预览",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "发布博客",
      "type": "npm",
      "script": "publish",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "postTitle",
      "type": "promptString",
      "description": "请输入文章标题"
    }
  ]
}
