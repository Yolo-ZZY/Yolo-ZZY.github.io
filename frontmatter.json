      ]
    },


    {
      "name": "思想随笔",
      "description": "用于记录学习感悟、个人思考和技术理解",

      "pageBundle": false,
      "fileType": "md",

      "template": "[[workspace]]/.frontmatter/templates/思想随笔.md",

      "fields": [
        {
          "title": "标题",
          "name": "title",
          "type": "string",
          "required": true
        },
        {
          "title": "发布日期",
          "name": "date",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "更新时间",
          "name": "updated",
          "type": "datetime",
          "default": "{{now}}",
          "isModifiedDate": true
        },
        {
          "title": "分类",
          "name": "categories",
          "type": "categories"
        },
        {
          "title": "标签",
          "name": "tags",
          "type": "tags"
        },
        {
          "title": "摘要",
          "name": "description",
          "type": "string"
        },
        {
          "title": "封面",
          "name": "cover",
